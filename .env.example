PORT=5100
NODE_ENV=development

# Local (non-Docker) dev: matches `npm run db:dev`'s embedded Postgres.
# Under docker-compose, this is set to postgres://...@postgres:5432/... instead.
DATABASE_URL=postgres://inventory_user:inventory_pass@localhost:5436/inventory_system

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:3001

# Points at restaurant-billing-backend's read-only integration API. The key
# must match INVENTORY_INTEGRATION_API_KEY in that app's .env.
BILLING_API_URL=http://localhost:5000/api
BILLING_INTEGRATION_API_KEY=change-this-shared-secret

# Used once by `npm run create-platform-admin` to bootstrap the first
# platform super-admin (provisions restaurants via /api/platform/*) --
# not a tenant user.
ADMIN_EMAIL=admin@inventory.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Platform Admin
